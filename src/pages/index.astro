---
import Layout from "../layouts/Layout.astro";
import AppFooter from "../components/react/AppFooter";
import AppHeader from "../components/react/AppHeader";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = (route: string) => `${basePath}${route}`;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER?.replace(/\D/g, "") || "";
const whatsappHref = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hola, quiero conocer Menu Templates para mi negocio")}`
  : "#contact";
---

<Layout title="Menu Templates - Menús y catálogos multi-tienda">
  <main class="min-h-screen overflow-hidden bg-[#fff8ef] text-gray-950">
    <AppHeader fixed client:load />

    <section class="relative flex min-h-[100svh] items-center px-6 py-24 sm:py-28">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(251,146,60,0.28),transparent_34%),radial-gradient(circle_at_bottom_right,rgba(20,184,166,0.16),transparent_28%),linear-gradient(135deg,#fff8ef_0%,#fffdf8_48%,#fff1d6_100%)]"></div>
      <div class="absolute left-1/2 top-24 h-72 w-72 -translate-x-1/2 rounded-full bg-orange-200/50 blur-3xl"></div>
      <div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="max-w-3xl">
          <p class="mb-5 inline-flex rounded-full border border-orange-200 bg-white/70 px-4 py-2 text-xs font-black uppercase tracking-[0.28em] text-orange-600 shadow-sm backdrop-blur">
            Menús · Catálogos · Administración
          </p>
          <h1 class="text-5xl font-black tracking-tight sm:text-6xl lg:text-7xl">
            Menús y catálogos para negocios.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-700 sm:text-xl">
            Una plataforma para restaurantes, emprendimientos gastronómicos y tiendas de productos que necesitan una vitrina pública lista para QR sin pagar infraestructura a medida.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={path("/login")} class="rounded-full bg-orange-600 px-7 py-4 text-center font-bold text-white shadow-xl shadow-orange-200 transition hover:-translate-y-0.5 hover:bg-orange-700">
              Entrar al sistema
            </a>
            <a href="#pricing" class="rounded-full bg-gray-950 px-7 py-4 text-center font-bold text-white shadow-xl shadow-orange-200 transition hover:-translate-y-0.5 hover:bg-gray-800">
              Ver planes
            </a>
            <a href={whatsappHref} class="rounded-full border border-gray-300 bg-white px-7 py-4 text-center font-bold text-gray-950 transition hover:-translate-y-0.5 hover:border-gray-950" target={whatsappNumber ? "_blank" : undefined} rel={whatsappNumber ? "noreferrer" : undefined}>
              Hablar por WhatsApp
            </a>
          </div>

          <div class="mt-10 grid max-w-xl grid-cols-3 gap-3 text-sm text-gray-700">
            <div class="rounded-2xl border border-orange-100 bg-white/70 p-4 shadow-sm backdrop-blur">
              <p class="text-2xl font-black text-gray-950">100%</p>
              <p class="mt-1">responsive</p>
            </div>
            <div class="rounded-2xl border border-orange-100 bg-white/70 p-4 shadow-sm backdrop-blur">
              <p class="text-2xl font-black text-gray-950">QR</p>
              <p class="mt-1">ready</p>
            </div>
            <div class="rounded-2xl border border-orange-100 bg-white/70 p-4 shadow-sm backdrop-blur">
              <p class="text-2xl font-black text-gray-950">Multi</p>
              <p class="mt-1">tienda</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="relative w-full h-64 sm:h-80 md:h-96 lg:h-[28rem] overflow-hidden rounded-[1.5rem] shadow-2xl">
            <img src={path('/background.jpg')} alt="Vista previa" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <section id="platform" class="relative flex min-h-[100svh] items-center px-6 py-20 md:py-24">
      <div class="absolute inset-0 bg-[linear-gradient(180deg,#fff8ef_0%,#ffffff_46%,#fff4df_100%)]" />
      <div class="absolute inset-x-8 top-10 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"></div>
      <div class="relative mx-auto flex w-full max-w-6xl flex-col justify-center gap-12">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.35em] text-orange-600">Tu plataforma, tu control</p>
          <h2 class="mt-5 text-4xl font-black leading-tight tracking-tight text-gray-950 sm:text-5xl lg:text-6xl">
            Lleva tu negocio a otro nivel con menús, catálogos y administración fácil.
          </h2>
          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-700 sm:text-xl">
            Una experiencia moderna para tu tienda: contenido público atractivo, gestión completa de tus productos y la flexibilidad para adaptar cada detalle a tu estilo.
          </p>
        </div>

        <div class="grid items-stretch gap-6 lg:grid-cols-3">
          <article class="group flex h-full flex-col overflow-hidden rounded-[2rem] border border-orange-200 bg-white/95 p-8 shadow-xl shadow-orange-200/20 backdrop-blur transition hover:-translate-y-1 hover:shadow-2xl hover:shadow-orange-300/30">
            <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-600">Público</p>
            <h3 class="mt-6 text-2xl font-black text-gray-950">Menús</h3>
            <p class="mt-5 leading-8 text-gray-600">Cada negocio puede crear su propio menú original y con gran diseño, ideal para mostrar platos, horarios y enlaces de contacto en una sola página.</p>
            <ul class="mt-8 space-y-3 text-gray-700">
              <li>✔ Menús QR modernos</li>
              <li>✔ Secciones por categoría</li>
              <li>✔ Estilo único para cada tienda</li>
            </ul>
          </article>

          <article class="group flex h-full flex-col overflow-hidden rounded-[2rem] border border-orange-200 bg-white/95 p-8 shadow-xl shadow-orange-200/20 backdrop-blur transition hover:-translate-y-1 hover:shadow-2xl hover:shadow-orange-300/30 lg:-translate-y-4">
            <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-600">Público</p>
            <h3 class="mt-6 text-2xl font-black text-gray-950">Catálogos</h3>
            <p class="mt-5 leading-8 text-gray-600">El negocio puede crear un catálogo de productos para la venta, con opciones de pedido a domicilio, en tienda y gestión clara de disponibilidad.</p>
            <ul class="mt-8 space-y-3 text-gray-700">
              <li>✔ Exhibición visual de productos</li>
              <li>✔ Pedidos rápidos desde el catálogo</li>
              <li>✔ Soporta stock y artículos agotados</li>
            </ul>
          </article>

          <article class="group flex h-full flex-col overflow-hidden rounded-[2rem] border border-orange-200 bg-white/95 p-8 shadow-xl shadow-orange-200/20 backdrop-blur transition hover:-translate-y-1 hover:shadow-2xl hover:shadow-orange-300/30">
            <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-600">Admin</p>
            <h3 class="mt-6 text-2xl font-black text-gray-950">Administración de tienda</h3>
            <p class="mt-5 leading-8 text-gray-600">Como dueño o encargado, puedes modificar todo a tu antojo: plantillas, menús, productos, stock y estados de disponibilidad.</p>
            <ul class="mt-8 space-y-3 text-gray-700">
              <li>✔ Cambios en tiempo real</li>
              <li>✔ Gestión de productos y stock</li>
              <li>✔ Control de plantillas y visibilidad</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section id="templates" class="relative flex min-h-[100svh] items-center px-6 py-20">
      <div class="mx-auto w-full max-w-6xl rounded-[2rem] bg-gray-950 p-8 text-white shadow-2xl shadow-gray-950/20 md:p-12">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-300">Plantillas, no solo cambios de color</p>
        <div class="mt-6 grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <h2 class="text-4xl font-black tracking-tight md:text-5xl">Cada tipo de negocio necesita una estructura distinta.</h2>
            <p class="mt-5 text-lg leading-8 text-white/70">Los layouts cambian la experiencia: lectura rápida, vitrina natural, promociones cálidas o presentación elegante. Los themes cambian la temporada sin duplicar código.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-white/10 p-5"><span class="text-2xl">▦</span><p class="mt-3 font-black">Minimalista</p><p class="mt-2 text-sm leading-6 text-white/65">Lectura rápida para cartas claras.</p></div>
            <div class="rounded-3xl bg-white/10 p-5"><span class="text-2xl">🌿</span><p class="mt-3 font-black">Natural</p><p class="mt-2 text-sm leading-6 text-white/65">Cafés, brunch y productos frescos.</p></div>
            <div class="rounded-3xl bg-white/10 p-5"><span class="text-2xl">🔥</span><p class="mt-3 font-black">Cálido</p><p class="mt-2 text-sm leading-6 text-white/65">Promos, combos y negocios familiares.</p></div>
            <div class="rounded-3xl bg-white/10 p-5"><span class="text-2xl">✦</span><p class="mt-3 font-black">Elegante</p><p class="mt-2 text-sm leading-6 text-white/65">Marcas premium y catálogos cuidados.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section id="pricing" class="relative px-6 py-20 md:py-24">
      <div class="absolute inset-0 bg-[linear-gradient(180deg,#fff4df_0%,#fffdf8_54%,#fff8ef_100%)]"></div>
      <div class="relative mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.35em] text-orange-600">Planes iniciales</p>
          <h2 class="mt-5 text-4xl font-black tracking-tight text-gray-950 sm:text-5xl">Empieza simple y escala cuando el negocio lo pida.</h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-gray-700">Precios pensados para validar clientes sin infraestructura costosa. Los límites pueden ajustarse desde el panel superadmin.</p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          <article class="rounded-[2rem] border border-orange-100 bg-white p-8 shadow-xl shadow-orange-100/50">
            <p class="text-sm font-black uppercase tracking-[0.25em] text-orange-600">Prueba</p>
            <h3 class="mt-4 text-3xl font-black text-gray-950">Free trial</h3>
            <p class="mt-3 text-gray-600">Ideal para montar una tienda demo y validar el menú con QR.</p>
            <p class="mt-8 text-4xl font-black">$0 <span class="text-base font-semibold text-gray-500">inicial</span></p>
            <ul class="mt-8 space-y-3 text-sm leading-6 text-gray-700">
              <li>✔ Menú o catálogo público</li>
              <li>✔ Plantilla y theme configurables</li>
              <li>✔ Productos y categorías base</li>
            </ul>
          </article>

          <article class="relative rounded-[2rem] border-2 border-orange-500 bg-gray-950 p-8 text-white shadow-2xl shadow-orange-200">
            <span class="absolute right-6 top-6 rounded-full bg-orange-500 px-3 py-1 text-xs font-black uppercase tracking-[0.18em]">Recomendado</span>
            <p class="text-sm font-black uppercase tracking-[0.25em] text-orange-300">Operación</p>
            <h3 class="mt-4 text-3xl font-black">Standard</h3>
            <p class="mt-3 text-white/70">Para negocios que necesitan administrar carta, contacto, horarios y disponibilidad.</p>
            <p class="mt-8 text-4xl font-black">A definir <span class="text-base font-semibold text-white/50">/ mes</span></p>
            <ul class="mt-8 space-y-3 text-sm leading-6 text-white/80">
              <li>✔ Panel de administración de tienda</li>
              <li>✔ Límites comerciales configurables</li>
              <li>✔ Preparado para pedidos manuales</li>
            </ul>
          </article>

          <article class="rounded-[2rem] border border-orange-100 bg-white p-8 shadow-xl shadow-orange-100/50">
            <p class="text-sm font-black uppercase tracking-[0.25em] text-orange-600">Crecimiento</p>
            <h3 class="mt-4 text-3xl font-black text-gray-950">Plus</h3>
            <p class="mt-3 text-gray-600">Para tiendas con más productos, stock, temporadas y necesidades de catálogo.</p>
            <p class="mt-8 text-4xl font-black">A definir <span class="text-base font-semibold text-gray-500">/ mes</span></p>
            <ul class="mt-8 space-y-3 text-sm leading-6 text-gray-700">
              <li>✔ Mayor capacidad de productos</li>
              <li>✔ Themes por temporada</li>
              <li>✔ Base para métricas y QR por tienda</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section id="contact" class="px-6 py-20">
      <div class="mx-auto grid max-w-6xl gap-8 rounded-[2rem] bg-orange-600 p-8 text-white shadow-2xl shadow-orange-200 md:grid-cols-[1fr_auto] md:items-center md:p-12">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.25em] text-orange-100">Siguiente paso</p>
          <h2 class="mt-4 text-4xl font-black tracking-tight md:text-5xl">Convierte una tienda real en tu primera demo vendible.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-orange-50">Crea la tienda, carga productos, elige layout/theme y comparte el enlace por QR o WhatsApp.</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
          <a href={path('/login')} class="rounded-full bg-white px-7 py-4 text-center font-black text-orange-700 transition hover:-translate-y-0.5 hover:bg-orange-50">Entrar al sistema</a>
          <a href={whatsappHref} target={whatsappNumber ? "_blank" : undefined} rel={whatsappNumber ? "noreferrer" : undefined} class="rounded-full border border-white/40 px-7 py-4 text-center font-black text-white transition hover:-translate-y-0.5 hover:bg-white/10">Hablar por WhatsApp</a>
        </div>
      </div>
    </section>
    <AppFooter />
  </main>
</Layout>
