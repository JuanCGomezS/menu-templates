---
import Layout from '../layouts/Layout.astro';
import { withBasePath } from '../lib/base-path';
---

<Layout title="Ruta de tienda">
  <main class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="max-w-md rounded-2xl bg-white p-8 text-center shadow-xl border border-gray-200">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-orange-600">URL de tienda</p>
      <h1 class="mt-3 text-2xl font-bold text-gray-950">Agrega el slug de una tienda</h1>
      <p class="mt-3 text-gray-600">Las tiendas públicas cargan en cliente en URLs como /t/slug-tienda; los enlaces directos usan el fallback 404 de GitHub Pages.</p>
      <a class="mt-6 inline-flex rounded-full bg-gray-950 px-5 py-3 font-semibold text-white hover:bg-gray-800" href={withBasePath('/')}>
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
