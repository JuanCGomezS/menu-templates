rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == role;
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    function isStoreAdminFor(storeId) {
      return hasRole('storeadmin') && userDoc().data.storeId == storeId;
    }

    function storeIsActive(storeId) {
      return exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.active == true;
    }

    function isPublicOrderCreate(storeId) {
      return storeIsActive(storeId)
        && request.resource.data.keys().hasOnly([
          'customerName',
          'customerPhone',
          'type',
          'status',
          'items',
          'total',
          'deliveryAddress',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 7
        && request.resource.data.customerPhone.size() <= 30
        && request.resource.data.type in ['in_store', 'delivery']
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 40
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isCustomerSelfCreate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.role == 'customer'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSuperAdmin() || isCustomerSelfCreate(uid);
      allow update, delete: if isSuperAdmin();
    }

    match /templates/{templateId} {
      allow read: if resource.data.active == true || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Compatibilidad temporal mientras se migran datos legacy de restaurants -> stores.
    match /restaurants/{restaurantId} {
      allow read: if resource.data.isActive == true || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();

      match /categories/{categoryId} {
        allow read: if get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.isActive == true || isSuperAdmin();
        allow create, update, delete: if isSuperAdmin();

        match /items/{itemId} {
          allow read: if get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.isActive == true || isSuperAdmin();
          allow create, update, delete: if isSuperAdmin();
        }
      }
    }

    match /stores/{storeId} {
      allow read: if resource.data.active == true || isSuperAdmin() || isStoreAdminFor(storeId);
      allow create, update, delete: if isSuperAdmin() || isStoreAdminFor(storeId);

      match /categories/{categoryId} {
        allow read: if (storeIsActive(storeId) && resource.data.active == true) || isSuperAdmin() || isStoreAdminFor(storeId);
        allow create, update, delete: if isSuperAdmin() || isStoreAdminFor(storeId);
      }

      match /items/{itemId} {
        allow read: if (storeIsActive(storeId) && resource.data.active == true) || isSuperAdmin() || isStoreAdminFor(storeId);
        allow create, update, delete: if isSuperAdmin() || isStoreAdminFor(storeId);
      }

      match /orders/{orderId} {
        allow create: if isPublicOrderCreate(storeId);
        allow read: if isSuperAdmin() || isStoreAdminFor(storeId);
        allow update: if isSuperAdmin() || isStoreAdminFor(storeId);
        allow delete: if isSuperAdmin();
      }

      match /{document=**} {
        allow read, write: if isSuperAdmin() || isStoreAdminFor(storeId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
