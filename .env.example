PUBLIC_FIREBASE_API_KEY=tu_api_key_publica
PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Opcional para enlaces comerciales/contacto.
PUBLIC_WHATSAPP_NUMBER=3000000000

# Solo para scripts administrativos locales. No se usa en el frontend.
# Descargá esta credencial desde Firebase Console > Configuración del proyecto > Cuentas de servicio.
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
