rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn()
        && (
          request.auth.token.role == role
          || (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && userDoc().data.role == role
          )
        );
    }

    function isSuperAdmin() {
      return signedIn() && userDoc().data.role == 'superadmin';
    }
    function isStoreAdminFor(storeId) {
      return signedIn()
        && (
          (request.auth.token.role == 'storeadmin' && request.auth.token.storeId == storeId)
          || (hasRole('storeadmin') && userDoc().data.storeId == storeId)
        );
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
